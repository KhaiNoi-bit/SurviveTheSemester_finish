<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ภาพพื้นหลังเต็มหน้าจอ -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/_79816d08_62f5_4711_82a3_bf251832bb22" />

    <!-- กล่องรวมปุ่ม อยู่กลางจอและเลื่อนลง 30dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="268dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="45dp"
        android:paddingEnd="45dp"
        android:translationY="30dp">

        <!-- ปุ่มเริ่มเกมใหม่ -->
        <TextView
            android:id="@+id/btnNewGame"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_yellow"
            android:gravity="center"
            android:text="เริ่มเกมใหม่"
            android:textColor="#452F00" />

        <!-- ปุ่มวิธีการเล่น -->
        <TextView
            android:id="@+id/btnHowTo"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_teal"
            android:gravity="center"
            android:text="วิธีการเล่น" />

        <!-- ปุ่มโหลดเกม -->
        <TextView
            android:id="@+id/btnLoad"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_blue"
            android:gravity="center"
            android:text="โหลดเกม" />

        <!-- ปุ่มตั้งค่า -->
        <TextView
            android:id="@+id/btnSettings"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_purple"
            android:gravity="center"
            android:text="ตั้งค่า" />

    </LinearLayout>

</FrameLayout>
