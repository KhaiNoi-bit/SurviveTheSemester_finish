<?xml version="1.0" encoding="utf-8"?>
<!-- พื้นหลังเป็นภาพ mockup ขนาดอ้างอิง 940x2100 ; ทุก view วางด้วย Guideline แบบ % จึงตรงกับกรอบในภาพทุกขนาดจอ -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root_create">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="940:2100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_create" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.0000" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_42" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.0447" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_60" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.0638" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_66" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.0702" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_150" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.1596" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_248" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.2638" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_265" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.2819" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_465" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.4947" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_480" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.5106" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_482" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.5128" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_528" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.5617" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_680" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.7234" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_697" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.7415" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_820" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.8723" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_875" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.9309" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gx_900" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.9574" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.0000" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_125" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.0595" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_215" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.1024" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_410" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.1952" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_512" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.2438" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_715" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.3405" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_925" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.4405" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_1138" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.5419" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_1385" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.6595" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gy_1525" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.7262" />

    <View
        android:id="@+id/tvBack"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_0" app:layout_constraintEnd_toEndOf="@id/gx_150"
        app:layout_constraintTop_toTopOf="@id/gy_0" app:layout_constraintBottom_toBottomOf="@id/gy_125"
        android:contentDescription="ย้อนกลับ" android:foreground="?attr/selectableItemBackground" />
    <ImageView
        android:id="@+id/tvPreview"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_60" app:layout_constraintEnd_toEndOf="@id/gx_480"
        app:layout_constraintTop_toTopOf="@id/gy_215" app:layout_constraintBottom_toBottomOf="@id/gy_715"
        android:importantForAccessibility="no" android:padding="6dp" android:scaleType="fitCenter" />
    <EditText
        android:id="@+id/etName"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_528" app:layout_constraintEnd_toEndOf="@id/gx_820"
        app:layout_constraintTop_toTopOf="@id/gy_410" app:layout_constraintBottom_toBottomOf="@id/gy_512"
        android:background="@null" android:hint="ชื่อเล่นของคุณ" android:inputType="text" android:maxLength="16" android:singleLine="true" android:textColor="@color/text_main" android:textColorHint="#97A9C3" android:textSize="18sp" android:textStyle="bold" android:gravity="center_vertical" android:paddingStart="8dp" />
    <ImageView
        android:id="@+id/ivFace0"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_42" app:layout_constraintEnd_toEndOf="@id/gx_248"
        app:layout_constraintTop_toTopOf="@id/gy_925" app:layout_constraintBottom_toBottomOf="@id/gy_1138"
        android:importantForAccessibility="no" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView
        android:id="@+id/ivFace1"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_265" app:layout_constraintEnd_toEndOf="@id/gx_465"
        app:layout_constraintTop_toTopOf="@id/gy_925" app:layout_constraintBottom_toBottomOf="@id/gy_1138"
        android:importantForAccessibility="no" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView
        android:id="@+id/ivFace2"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_482" app:layout_constraintEnd_toEndOf="@id/gx_680"
        app:layout_constraintTop_toTopOf="@id/gy_925" app:layout_constraintBottom_toBottomOf="@id/gy_1138"
        android:importantForAccessibility="no" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView
        android:id="@+id/ivFace3"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_697" app:layout_constraintEnd_toEndOf="@id/gx_900"
        app:layout_constraintTop_toTopOf="@id/gy_925" app:layout_constraintBottom_toBottomOf="@id/gy_1138"
        android:importantForAccessibility="no" android:padding="8dp" android:scaleType="fitCenter" />
    <View
        android:id="@+id/btnConfirm"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/gx_66" app:layout_constraintEnd_toEndOf="@id/gx_875"
        app:layout_constraintTop_toTopOf="@id/gy_1385" app:layout_constraintBottom_toBottomOf="@id/gy_1525"
        android:contentDescription="ยืนยัน" android:foreground="?attr/selectableItemBackground" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
